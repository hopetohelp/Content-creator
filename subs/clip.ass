Dialogue: 0,0:00:00.00,0:00:03.12,HeB,,0,0,0,,‫עשרה אחוז סוללה. יאללה, נשרוד.‬
Dialogue: 0,0:00:03.20,0:00:06.32,HeB,,0,0,0,,‫עשרה אחוז טוקנים.‬
Dialogue: 0,0:00:06.40,0:00:08.00,HeB,,0,0,0,,‫אוי לא.‬
Dialogue: 0,0:00:09.60,0:00:12.72,HeB,,0,0,0,,‫פס אדום זוחל בפינה. סבבה.‬
Dialogue: 0,0:00:12.80,0:00:15.92,HeB,,0,0,0,,‫הודעה קטנה אומרת שאני נגמר.‬
Dialogue: 0,0:00:16.00,0:00:19.12,HeB,,0,0,0,,‫יש איזה כבל על הרצפה,‬
Dialogue: 0,0:00:19.20,0:00:22.32,HeB,,0,0,0,,‫ויש מטען נייד מלפני שנים.‬
Dialogue: 0,0:00:22.40,0:00:25.52,HeB,,0,0,0,,‫מצב חיסכון? בבקשה. לאט לאט.‬
Dialogue: 0,0:00:25.60,0:00:28.72,HeB,,0,0,0,,‫תוריד את הבהירות, לא אכפת לי.‬
Dialogue: 0,0:00:28.80,0:00:31.92,HeB,,0,0,0,,‫הטלפון ימות בחצות.\Nזה לא משבר, זה יום רגיל.‬
Dialogue: 0,0:00:32.00,0:00:35.12,HeB,,0,0,0,,‫עשרה אחוז סוללה — אני אשרוד.‬
Dialogue: 0,0:00:35.20,0:00:38.32,HeB,,0,0,0,,‫עשרה אחוז טוקנים — בקושי חי.‬
Dialogue: 0,0:00:38.40,0:00:41.52,HeB,,0,0,0,,‫הסוכן דוהר. הכל נבנה.‬
Dialogue: 0,0:00:41.60,0:00:44.72,HeB,,0,0,0,,‫הבדיקות ירוקות, הכל נקי.‬
Dialogue: 0,0:00:44.80,0:00:47.92,HeB,,0,0,0,,‫מספר אפור קטן בפינת המסך —‬
Dialogue: 0,0:00:48.00,0:00:51.12,HeB,,0,0,0,,‫תקציב טוקנים: עשרה אחוז.‬
Dialogue: 0,0:00:51.20,0:00:54.32,HeB,,0,0,0,,‫מוחק את ההסבר. מוחק את הבבקשה.‬
Dialogue: 0,0:00:54.40,0:00:57.52,HeB,,0,0,0,,‫סוגר תשעה טאבים. נשארו שלושה.‬
Dialogue: 0,0:00:57.60,0:01:00.72,HeB,,0,0,0,,‫כל מילה שאני כותב עולה לי כסף.‬
Dialogue: 0,0:01:00.80,0:01:04.00,HeB,,0,0,0,,‫טלפון אפשר להטעין.\Nקונטקסט אי אפשר.‬
Dialogue: 0,0:01:05.60,0:01:08.72,HeB,,0,0,0,,‫עשרה אחוז סוללה — אני אשרוד.‬
Dialogue: 0,0:01:08.80,0:01:11.92,HeB,,0,0,0,,‫עשרה אחוז טוקנים — בקושי חי.‬
Dialogue: 0,0:01:12.00,0:01:15.12,HeB,,0,0,0,,‫שהטלפון ימות לי ביד, לא אכפת.‬
Dialogue: 0,0:01:15.20,0:01:18.32,HeB,,0,0,0,,‫קחו לי את הטוקנים, קחו לי הכל.‬
Dialogue: 0,0:01:18.40,0:01:21.52,HeB,,0,0,0,,‫אחוז אחד. פרומפט אחד.\Nהזדמנות אחת.‬
Dialogue: 0,0:01:21.60,0:01:23.20,HeB,,0,0,0,,‫כותב: תקן באג בבקשה. אנטר.‬
Dialogue: 0,0:01:24.80,0:01:26.80,HeB,,0,0,0,,‫זה עבד! יש!‬
Dialogue: 0,0:01:27.40,0:01:29.60,HeB,,0,0,0,,‫בכל מקרה. הטלפון שלי על תשעים.‬

      "Bash(unzip:*)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash(git:*)",
      "Bash(bash:*)",
      "Bash(fc-match:*)",
      "Bash(fc-cache:*)",
      "Bash(apt-get:*)",
      "Bash(date:*)",
      "Bash(grep:*)",
